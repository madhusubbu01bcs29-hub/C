#include<stdio.h>
int main()
{
   char str[200];
   int i=0;
   int alphabets=0,digits=0,spaces=0,special=0;
   printf("Enter a string:");
   fgets(str,sizeof(str),stdin);
   while(str[i+1]!='\0')
   {
      if((str[i]>='a' && str[i]<='z')||(str[i]>='A' && str[i]<='Z'))
      {
         alphabets++;
      }
      else if(str[i]>='0' && str[i]<='9')
      {
         digits++;
      }
      else if(str[i]==' ')
      {
         spaces++;
      }
      else
      {
         special++;
      }
      i++;
   }
   printf("No.of alphabets:%d\n",alphabets);
   printf("No.of digits:%d\n",digits);
   printf("No.of spaces:%d\n",spaces);
   printf("No.of special character:%d\n",special);
   printf("No.of character:%d",i);
   return 0;
}
