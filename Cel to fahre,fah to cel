#include<stdio.h>
float f_to_c(float f);
float c_to_f(float c);
float f_to_c(float f)
{
   float c;
   c=(f-32)*5/9;
   return c;
}
float c_to_f(float c)
{
   float f;
   f=(c*(5/9))+32;
   return f;
}
int main()
{
   int choice;
   float f,c,res;
   do
   {
      printf("\n1.fahrenheit to celsius");
      printf("\n2.celsius to fahrenheit");
      printf("\n3.exit");
      printf("\nEnter a choice:");
      scanf("%d",&choice);
      switch(choice)
      {
         case 1:
            printf("Enter the fahrenheit value:");
            scanf("%f",&f);
            res=f_to_c(f);
            printf("The celsius value is %f",res);
            break;
         case 2:
            printf("Enter the celsius value:");
            scanf("%f",&c);
            res=c_to_f(c);
            printf("The fahrenheit value is %f",res);
            break;
         case 3:
            printf("exit");
            break;
         default:
            printf("Invalid choice");
      }
   }while(choice!=3);
   return 0;
}
