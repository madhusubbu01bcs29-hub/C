#include<stdio.h>
int main()
{
   int a[100],i,j,temp,n;
   printf("Enter number of elements:");
   scanf("%d",&n);
   printf("Enter the elements:\n");
   for(i=0;i<n;i++)
   {
       scanf("%d",&a[i]);
   }
   for(i=0;i<n-1;i++)
   {
      for(j=0;j<n-1-i;j++)
      {
         if(a[j]>a[j+1])
         {
            temp=a[j];
            a[j]=a[j+1];
            a[j+1]=temp;
         }
      }
   }
   printf("\nsorted elements:");
   for(i=0;i<n;i++)
   {
      printf("%d\t",a[i]);
   }
   printf("\n The third smallest elements in array is %d",a[2]);
   return 0;
}
