#include<stdio.h>
int main()
{
   char a[10];
   int i=0;
   printf("Enter a string:");
   fgets(a,sizeof(a),stdin);
   while(a[i]!='\0')
   {
      if(a[i]>='a'&&a[i]<='z')
      {
         a[i]=a[i]-32;
      }
      else
      {
         a[i]=a[i];
      }
      i++;
   }
   printf("uppercase string:%s",a);
   return 0;
}
