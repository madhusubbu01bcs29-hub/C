#include<stdio.h>
int power(int base,int e);
int power(int base,int e)
{
   if(e==0)
   {
      return 1;
   }
   else
   {
      return(base*power(base,e-1));
   }
}
int main()
{
   int base,e,result;
   printf("Enter base number:");
   scanf("%d",&base);
   printf("Enter power number(positive integer):");
   scanf("%d",&e);
   result=power(base,e);
   printf("%d^%d=%d",base,e,result);
   return 0;
}
