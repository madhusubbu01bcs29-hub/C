#include<stdio.h>
void swap(int *a,int *b);
void swap(int *a,int *b)
{
   int temp;
   temp=*a;
   *a=*b;
   *b=temp;
   printf("inside swap(call by reference):a=%d,b=%d\n",*a,*b);
}
int main()
{
   int x,y;
   printf("Enter 1st number:");
   scanf("%d",&x);
   printf("Enter 2nd number:");
   scanf("%d",&y);
   swap(&x,&y);
   printf("in main after swap:x=%d,y=%d\n",x,y);
   return 0;
}
