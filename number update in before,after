#include<stdio.h>
void update_values(int*x,int*y);
void update_values(int*x,int*y)
{
   *x=*x*2;
   *y=*y*3;
}
int main()
{
   int a,b;
   printf("Enter 1st number:");
   scanf("%d",&a);
   printf("Enter 2nd number:");
   scanf("%d",&b);
   printf("Before update\n");
   printf("a=%d\n",a);
   printf("b=%d\n",b);
   update_values(&a,&b);
   printf("a(doubled)=%d\n",a);
   printf("b(tripled)=%d\n",b);
   return 0;
}
