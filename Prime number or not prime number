#include<stdio.h>
#include<math.h>
int is_prime(int n);
int is_prime(int n)
{
   int i;
   if(n<=1)
      return 0;
   for(i=2;i<=sqrt(n);i++)
   {
      if(n%i==0)
         return 0;
   }
   return 1;
}
int main()
{
   int num,result;
   printf("Enter a number:");
   scanf("%d",&num);
   result=is_prime(num);
   if(result==1)
   {
      printf("%d is a prime number\n",num);
   }
   else
   {
      printf("%d is not a prime number\n",num);
   }
   return 0;
}
